# GEMINI_API_KEY: Required for server-side Gemini AI extraction (GitHub evidence, event URLs, PDF brochures & image posters).
# AI Studio automatically injects this at runtime from user secrets (Settings > Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth redirect URIs (/auth/pesu/callback), and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Optional personal access token to increase GitHub REST API rate limits from 60/hr to 5000/hr.
# Without this, public unauthenticated GitHub REST API calls still work up to 60 requests/hr.
GITHUB_TOKEN=""

# PESU_OAUTH_CLIENT_ID: Client ID registered with PESU-Dev OAuth2 provider (https://pesu-oauth2.onrender.com).
PESU_OAUTH_CLIENT_ID=""

# PESU_OAUTH_CLIENT_SECRET: Client Secret registered with PESU-Dev OAuth2 provider (kept strictly server-side).
PESU_OAUTH_CLIENT_SECRET=""

# PESU_OAUTH_ISSUER_URL: Base URL for PESU-Dev OAuth2 OIDC provider.
PESU_OAUTH_ISSUER_URL="https://pesu-oauth2.onrender.com"
