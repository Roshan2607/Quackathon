# =============================================================================
# Quackathon — local environment template
#
# Copy this file to `.env` and fill in the values for the services you use.
# `.env` is git-ignored: never commit real keys, passwords or tokens.
#
# Every variable below is read by the code. Variables marked "optional" may be
# left empty; the app starts and serves JSON without them, but the matching
# integration will report itself as "not configured".
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# PORT: TCP port for the Express API + Vite (dev) / static bundle (production).
PORT="3000"

# NODE_ENV: "development" runs Vite in middleware mode; "production" serves the
# built bundle from ./dist (run `npm run build` first).
NODE_ENV="development"

# APP_URL: Public origin of this deployment. Used for OAuth redirect URIs
# ("${APP_URL}/auth/pesu/callback"), same-origin postMessage checks and the
# registered-redirect allow list.
APP_URL="http://127.0.0.1:3000"

# SESSION_SECRET: Secret used to sign the session cookie (quackathon_sid).
# Optional in development (a random secret is generated per process, which
# invalidates sessions on restart). REQUIRED in production, otherwise every
# restart signs new sessions with a different key.
SESSION_SECRET=""

# QUACKATHON_TEST_MODE: Set to "true" only for automated test runs. It prevents
# server.ts from binding a port when it is imported by the test runner.
QUACKATHON_TEST_MODE="false"

# -----------------------------------------------------------------------------
# PostgreSQL (Drizzle ORM) — REQUIRED for profiles, events, teams and chat
# -----------------------------------------------------------------------------
# SQL_HOST / SQL_PORT / SQL_DB_NAME: connection target of the app database.
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_DB_NAME="quackathon"

# SQL_USER / SQL_PASSWORD: role used by the app at runtime.
SQL_USER="quackathon_app"
SQL_PASSWORD=""

# SQL_SSL: set to "true" for hosted Postgres that requires TLS.
SQL_SSL="false"

# SQL_ADMIN_USER / SQL_ADMIN_PASSWORD: OPTIONAL. Only used by drizzle-kit for
# DDL (npm run db:generate / db:migrate / db:push). Falls back to SQL_USER /
# SQL_PASSWORD when unset, so a single role is enough for local development.
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Gemini API (server-side) — OPTIONAL
# -----------------------------------------------------------------------------
# GEMINI_API_KEY: Required for AI-assisted extraction (GitHub project
# summaries, event URL/brochure extraction, poster vision). Deterministic
# (non-AI) extraction works without it.
GEMINI_API_KEY=""

# GEMINI_PRIMARY_MODEL / GEMINI_FALLBACK_MODEL: Model selection and the
# fallback used on transient 429/503 responses.
GEMINI_PRIMARY_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-2.0-flash"

# GEMINI_MAX_RETRIES: Bounded retries for transient failures (0-3).
GEMINI_MAX_RETRIES="2"

# GEMINI_TIMEOUT_MS: Per-request timeout for Gemini calls.
GEMINI_TIMEOUT_MS="20000"

# -----------------------------------------------------------------------------
# GitHub REST API — OPTIONAL
# -----------------------------------------------------------------------------
# GITHUB_TOKEN: Personal access token. Without it, public unauthenticated
# GitHub calls still work but are limited to 60 requests/hour.
GITHUB_TOKEN=""

# -----------------------------------------------------------------------------
# PESU-Dev OAuth2 (student identity) — OPTIONAL
# -----------------------------------------------------------------------------
# PESU_OAUTH_CLIENT_ID / PESU_OAUTH_CLIENT_SECRET: Credentials of an OAuth2
# client registered with PESU-Dev. The secret stays server-side.
PESU_OAUTH_CLIENT_ID=""
PESU_OAUTH_CLIENT_SECRET=""

# PESU_OAUTH_ISSUER_URL: OIDC issuer of the PESU-Dev provider.
PESU_OAUTH_ISSUER_URL="https://pesu-oauth2.onrender.com"

# PESU_OAUTH_REDIRECT_URI: Optional explicit override for the registered
# callback URL. Defaults to "${APP_URL}/auth/pesu/callback".
PESU_OAUTH_REDIRECT_URI=""

# -----------------------------------------------------------------------------
# Firebase Authentication — OPTIONAL
# -----------------------------------------------------------------------------
# The browser Firebase config (projectId, apiKey, authDomain, ...) lives in
# firebase-applet-config.json and is a public client configuration.
#
# Verifying Firebase ID tokens on the server requires a service account:
#   * either set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file
#     path in the server environment, or
#   * leave it unset — Google sign-in then fails server-side with a clear
#     "Firebase ID token verification failed" error instead of silently
#     trusting the token.
# No Firebase secret is stored in this repository.
